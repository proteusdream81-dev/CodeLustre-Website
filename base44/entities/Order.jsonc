{
  "name": "Order",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "enum": [
        "stripe",
        "paypal"
      ],
      "default": "stripe"
    },
    "stripe_session_id": {
      "type": "string",
      "description": "Provider reference: Stripe checkout session id, or PayPal order id for PayPal payments."
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "expired"
      ],
      "default": "pending"
    },
    "currency": {
      "type": "string",
      "default": "aud"
    },
    "amount_total": {
      "type": "number"
    },
    "customer_email": {
      "type": "string"
    },
    "shipping_name": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_amount": {
            "type": "number"
          }
        }
      }
    }
  },
  "required": [
    "stripe_session_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}